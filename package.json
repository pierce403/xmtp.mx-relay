{
  "name": "xmtp.mx-server",
  "version": "1.0.0",
  "description": "Bidirectional XMTP / email relay with a staged Cloudflare target",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "fake:mailgun": "node scripts/fake-mailgun-inbound.js",
    "cf:dev": "npm --prefix cf-worker run dev",
    "cf:deploy": "npm --prefix cf-worker run deploy",
    "cf:dry-run": "cf-worker/node_modules/.bin/wrangler deploy --dry-run --config cf-worker/wrangler.toml",
    "typecheck:cloudflare": "npm --prefix cf-worker run typecheck",
    "typecheck:container": "npm --prefix container run typecheck",
    "build:container": "npm --prefix container run build",
    "test:cloudflare:unit": "cf-worker/node_modules/.bin/vitest run --config tests/vitest.config.mjs",
    "test:cloudflare:smoke-harness": "node --test tests/cloudflare-smoke.test.mjs",
    "test:cloudflare": "npm run test:cloudflare:unit && npm run test:cloudflare:smoke-harness",
    "test:container": "npm --prefix container test",
    "smoke:cloudflare": "node scripts/cloudflare-smoke.mjs",
    "test:integration": "ts-node test_integration.ts",
    "xmtp:revoke-installations": "node dist/recoverXmtpInstallations.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@xmtp/node-sdk": "^3.2.2",
    "@xmtp/xmtp-js": "^13.0.1",
    "better-sqlite3": "^12.4.1",
    "busboy": "^1.6.0",
    "dotenv": "^16.4.5",
    "ethers": "^5.7.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "form-data": "^4.0.0",
    "mailgun.js": "^10.2.3",
    "pino": "^9.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251217.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/busboy": "^1.5.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.55.0"
  }
}
