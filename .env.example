# Legacy Railway/Mailgun rollback runtime
#
# The staged Cloudflare target is configured through cf-worker/wrangler.toml,
# Cloudflare Secrets, and container/.env.example. No production cutover has
# occurred, so retain these legacy variables for rollback; do not copy the
# legacy installation-revocation controls into the Cloudflare Container.
NODE_ENV=development
PORT=3000
DATA_DIR=./data

# Inbound SMTP recipient (Mailgun route should forward this to /webhooks/mailgun/inbound)
INBOUND_EMAIL_TO=deanpierce.eth@xmtp.mx

# XMTP bot (required)
XMTP_ENV=production
XMTP_BOT_KEY=
XMTP_DEAN_ADDRESS=deanpierce.eth
# Legacy service resolves ENS/address entries at startup. The Cloudflare D1
# allowlist is different: it accepts normalized 64-hex XMTP inbox IDs only.
XMTP_ALLOWED_SENDERS=deanpierce.eth

# Legacy installation safety. For the existing production identity, all three
# values below must remain false during migration/rollback unless a separate,
# reviewed emergency procedure explicitly says otherwise.
XMTP_ALLOW_NEW_INSTALLATION=false
XMTP_EMERGENCY_REVOKE_INSTALLATIONS=false
XMTP_ENFORCE_SINGLE_INSTALLATION=false

# CLI helper: when revoking installations, keep N and revoke the rest.
XMTP_REVOKE_KEEP_INSTALLATIONS=1

# Optional (startup/error notifications over XMTP)
ADMIN_XMTP_ADDRESS=

# Optional (used to resolve ENS names like `name.eth`)
# Defaults to https://ethereum.publicnode.com (Ethereum mainnet).
ETH_RPC_URL=

# Legacy Mailgun rollback only; remove only after Cloudflare A-J and rollback gates pass.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=xmtp.mx
MAILGUN_WEBHOOK_SIGNING_KEY=
MAILGUN_FROM="Dean (XMTP) <deanpierce.eth@xmtp.mx>"

# Webhook limits (optional)
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX=60
MAX_INBOUND_FIELD_SIZE_BYTES=5242880

# Integration test (optional)
XMTP_TEST_SENDER_KEY=
XMTP_BOT_ADDRESS_OR_ENS=
TEST_EMAIL_RECIPIENT=

# Cloudflare operator/smoke environment (not consumed by the root legacy service).
# Never commit real values. Runtime relay secrets are set with `wrangler secret
# put`; see docs/cloudflare-migration-runbook.md for the complete list.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
SMOKE_EDGE_URL=
SMOKE_FRONTEND_URL=https://xmtp.mx
SMOKE_ADMIN_TOKEN=
SMOKE_INTERNAL_SECRET=
CLOUDFLARE_RECOVERY_ADMIN_TOKEN=
