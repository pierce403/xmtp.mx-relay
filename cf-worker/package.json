{
  "name": "@xmtp.mx/cloudflare-relay-edge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy --config wrangler.toml",
    "dev": "wrangler dev --test-scheduled --config wrangler.toml",
